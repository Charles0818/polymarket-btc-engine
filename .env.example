# ============================================================
# Polymarket BTC Trading Engine — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.

# --- Wallet ---
# Your Ethereum private key (with or without 0x prefix).
# This wallet must be funded with USDC on Polygon and have
# approved the Polymarket CTF Exchange contract.
PRIVATE_KEY=

# --- Chain ---
# 137 = Polygon mainnet, 80002 = Amoy testnet
CHAIN_ID=137

# --- Polymarket CLOB ---
# The CLOB API host. Default is production.
CLOB_API_URL=https://clob.polymarket.com

# --- Optional: Pre-derived API credentials ---
# If you've already derived CLOB API keys, you can provide them here
# to skip the derivation step on startup. Leave blank to auto-derive.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- Risk Controls ---
# Maximum USDC to risk per round (overrides strategy default)
MAX_RISK_PER_ROUND=2.00
# Maximum total USDC exposure across all open positions
MAX_TOTAL_EXPOSURE=20.00
# Kill switch: set to "true" to immediately halt all trading
KILL_SWITCH=false

# --- Geo-blocking (optional) ---
# If you need a geo-block bypass token
GEO_BLOCK_TOKEN=
